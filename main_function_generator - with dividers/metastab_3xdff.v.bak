module metastab_3xdff
#(

	parameter N_BIT = 8

)
(
	
	// ---- INPUT PINS ---- //
	input clk, rst_n,
	
	input [N_BIT-1:0] d,
	
	// ---- OUTPUT PINS ---- //
	output reg [N_BIT-1:0] q

);
	
	reg [N_BIT-1:0] q_1, q_2;
	always @(posedge clk) begin
		
		if(rst_n == 0) begin
			//reset condition
			q <= 0;
		end else begin
			//shift condition
			q <= q_2;
			q_2 <= q_1;
			q_1 <= d;
		end
		
	end

endmodule
