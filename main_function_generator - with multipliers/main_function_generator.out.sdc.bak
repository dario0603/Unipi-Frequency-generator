#**************************************************************
# Time Information
#**************************************************************

set_time_format -unit ns -decimal_places 3



#**************************************************************
# Create Clock
#**************************************************************

create_clock -name {CLOCK_50} -period 20.000 -waveform { 0.000 10.000 } [get_ports {CLOCK_50}]
create_clock -name {keypad_freq_sel_module:inst1|freq_divider_keypad_module:freq_div|q} -period 1.000 -waveform { 0.000 0.500 } [get_registers {keypad_freq_sel_module:inst1|freq_divider_keypad_module:freq_div|q}]
create_clock -name {ddfs:inst15|freq_divider_DDFS:f_div_inst|count[19]} -period 10.000 -waveform { 0.000 5.000 } [get_registers { ddfs:inst15|freq_divider_DDFS:f_div_inst|count[19] }]


#**************************************************************
# Create Generated Clock
#**************************************************************

create_generated_clock -name {inst|altpll_component|pll|clk[0]} -source [get_pins {inst|altpll_component|pll|inclk[0]}] -duty_cycle 50.000 -multiply_by 4 -master_clock {CLOCK_50} [get_pins {inst|altpll_component|pll|clk[0]}] 


